    },
    {
      "type": "paragraph",
      "style": "Normal",
      "text": "Singapore-registered vehicles leaving Singapore via land checkpoints must have at three-quarters of a tank of motor fuel.",
      "formatting": {
        "bold_ratio": 0.0,
        "mostly_bold": false,
        "max_font_size_pt": null
      },
      "list": {
        "is_list_item": false,
        "level": null,
        "num_id": null,
        "detected_from": null
      },
      "hyperlinks": [
        {
          "text": "three-quarters of a tank",
          "url": "https://www.customs.gov.sg/at-customs/departing-singapore/three-quarter-tank-rule/"
        }
      ]
    },
    {
      "type": "paragraph",
      "style": "Normal",
      "text": "Composition Amounts for Three-Quarter Tank Offences",
      "formatting": {
        "bold_ratio": 0.0,
        "mostly_bold": false,
        "max_font_size_pt": null
      },
      "list": {
        "is_list_item": false,
