        }
      ]
    },
    {
      "type": "paragraph",
      "style": "Normal",
      "text": "Provide supporting documents",
      "formatting": {
        "bold_ratio": 0.0,
        "mostly_bold": false,
        "max_font_size_pt": null
      },
      "list": {
        "is_list_item": true,
        "level": 0,
        "num_id": 11,
        "detected_from": "paragraph"
      },
      "hyperlinks": []
    },
    {
      "type": "paragraph",
      "style": "Normal",
      "text": "Appeals are assessed on a case-by-case basis. Repeated appeals without new grounds, appeals without documents, or requests for instalment payments are generally not considered.",
      "formatting": {
        "bold_ratio": 0.0,
        "mostly_bold": false,
        "max_font_size_pt": null
      },
      "list": {
        "is_list_item": false,
        "level": null,
        "num_id": null,
        "detected_from": null
      },
      "hyperlinks": []
    },
    {
      "type": "paragraph",
      "style": "Normal",
      "text": "For three-quarter tank offences, submitting an appeal does not remove the requirement to attend court unless payment of the composition sum has been made.",
      "formatting": {
        "bold_ratio": 0.0,
        "mostly_bold": false,
        "max_font_size_pt": null
      },
      "list": {
        "is_list_item": false,
