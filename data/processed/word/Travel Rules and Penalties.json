      "style": "Normal",
      "text": "Failing to declare goods or comply with customs rules is an offence.",
      "formatting": {
        "bold_ratio": 0.0,
        "mostly_bold": false,
        "max_font_size_pt": null
      },
      "list": {
        "is_list_item": false,
