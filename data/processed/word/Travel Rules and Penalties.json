    },
    {
      "type": "paragraph",
      "style": "Normal",
      "text": "If you wish to submit an appeal relating to a Notice of Customs Offence, you must:",
      "formatting": {
        "bold_ratio": 0.0,
        "mostly_bold": false,
        "max_font_size_pt": null
      },
      "list": {
        "is_list_item": false,
        "level": null,
        "num_id": null,
        "detected_from": null
      },
      "hyperlinks": []
    },
    {
      "type": "paragraph",
      "style": "Normal",
      "text": "Submit the appeal through the Customs Appeals Form",
      "formatting": {
        "bold_ratio": 0.0,
        "mostly_bold": false,
        "max_font_size_pt": null
      },
      "list": {
        "is_list_item": true,
