  "itineraries": [
    {
      "index": 1,
      "title": "Sentosa",
      "description": "Singapore's premier island resort getaway, spanning 500 hectares of lush tropical landscape and golden beaches just 15 minutes from the city centre.\n\nThis vibrant destination seamlessly blends nature, adventure, and premium and differentiated resorts, offering everything from peaceful nature walks to thrilling attractions.",
      "image": {
        "url": "https://changiairport.scene7.com/is/image/changiairport/sentosa-gateway",
        "alt": "Central Business District"
      },
      "source_component": "cmp-cardlisting--tlslider",
      "slider_index": 1,
      "slide_index": 1
    },
    {
      "index": 2,
      "title": "Universal Studios Singapore, Resorts World Sentosa",
      "description": "Universal Studios Singapore is nestled within Resorts World Sentosa, a premier integrated resort offering diverse entertainment across 49 hectares. This world-class destination combines thrilling theme park attractions with luxury accommodations, dining, and unique experiences all in one location.\n\nCapture the perfect photo with the iconic Universal globe – the stunning landmark that welcomes visitors to Southeast Asia's first and only Universal Studios theme park, where immersive movie-themed attractions and exhilarating rides bring beloved blockbusters to life.\n\nBeyond the theme park experience, the integrated resort also houses the Singapore Oceanarium, Adventure Cove Waterpark, and eight premium hotels.\n\nUniversal elements and all related indicia TM & ©️ 2025.\nUniversal Studios. All Rights Reserved.",
      "image": {
        "url": "https://www.changiairport.com/content/dam/changiairport/sg/airport/evergreen/experience/free-tours/free-singapore-tours/sentosa-discovery-tour/uss-globe-couple.jpg",
        "alt": "Chinatown"
      },
      "source_component": "cmp-cardlisting--tlslider",
      "slider_index": 1,
      "slide_index": 2
    },
    {
      "index": 3,
      "title": "Sentosa Sensoryscape",
      "description": "One of the newest additions to Sentosa, Sentosa Sensoryscape is a one-of-a-kind, multi-sensory experience that links Resorts World Sentosa to the beach areas via an immersive 350-metre walking trail.\n\nExplore six enchanting sensory gardens that awaken all your senses through captivating experiences blending nature, architecture, and innovative technology.",
      "image": {
        "url": "https://changiairport.scene7.com/is/image/changiairport/sensoryscape-sentosa",
        "alt": ""
      },
      "source_component": "cmp-cardlisting--tlslider",
      "slider_index": 1,
      "slide_index": 3
    },
    {
      "index": 4,
      "title": "Siloso Beach",
      "description": "The most energetic and activity-filled stretch of coastline on Sentosa.\n\nKnown for its vibrant beach culture, Siloso is where you’ll find beach volleyball courts, water sports rentals, and a lively atmosphere with buzzing beach clubsthat draws locals and tourists all day!",
      "image": {
        "url": "https://changiairport.scene7.com/is/image/changiairport/cbb-evening-sentosa",
        "alt": "Singapore River"
      },
      "source_component": "cmp-cardlisting--tlslider",
      "slider_index": 1,
      "slide_index": 4
    },
    {
      "index": 5,
      "title": "Optional add-on for 3pm tour*",
      "description": "Singapore Cable Car – Sentosa Line.\n\nSee Sentosa from a new perspective. Soar above the island’s vibrant attractions and golden tropical shorelines on the Singapore Cable Car Sentosa Line. It’s the ultimate shortcut to the best views in the city, offering a breathtaking look at Sentosa’s beaches and skyline from high above the trees.\n\n*Add-on is optional and comes with an additional cost, at your own expense. Payment will be collected during the tour. Please note that this option is only available for the 3pm tour.",
      "image": {
        "url": "https://changiairport.scene7.com/is/image/changiairport/fst-sentosa-cable-car",
        "alt": "fst sentosa cable car"
      },
      "source_component": "cmp-cardlisting--tlslider",
      "slider_index": 1,
      "slide_index": 5
    },
    {
      "index": 6,
      "title": "Optional add-on for 7pm tour*: Wings of Time Fireworks Symphony",
      "description": "Enhance your experience with Singapore’s only daily fireworks show at Siloso Beach. Set against the open sea, this dazzling spectacle features fireworks, laser lights, water jets, and moving musical soundtrack\n\n*Add-on is optional and comes with an additional cost, at your own expense. Payment will be collected during the tour.",
      "image": {
        "url": "https://changiairport.scene7.com/is/image/changiairport/wingsoftime-sentosa",
        "alt": "Kampong Gelam"
      },
      "source_component": "cmp-cardlisting--tlslider",
      "slider_index": 1,
      "slide_index": 6
    }
  ],
