  "itineraries": [
    {
      "index": 1,
      "title": "Central Business District",
      "description": "Singapore’s financial and commercial district impresses with its modern skyscrapers.\n\nSituated in the middle is Singapore’s most historic Hawker Centre, Lau Pa Sat, home to a variety of local hawker fare and a bustling night street food scene.",
      "image": {
        "url": "https://changiairport.scene7.com/is/image/changiairport/heritage3-centralbusinessdistrict",
        "alt": "Central Business District"
      },
      "source_component": "cmp-cardlisting--tlslider",
      "slider_index": 1,
      "slide_index": 1
    },
    {
      "index": 2,
      "title": "Chinatown (30-minute stopover)",
      "description": "Chinatown is a culturally rich precinct featuring a mix of pre-war shophouses and iconic places of worship. Explore street murals painted by local artists that depict the daily lives of locals in the past.",
      "image": {
        "url": "https://changiairport.scene7.com/is/image/changiairport/heritage1-buddhatoothrelic",
        "alt": "Chinatown"
      },
      "source_component": "cmp-cardlisting--tlslider",
      "slider_index": 1,
      "slide_index": 2
    },
    {
      "index": 3,
      "title": "Optional add-on: Chinatown Heritage Centre*",
      "description": "Get a glimpse of the various iconic landmarks of Singapore scattered around Marina Bay. Keep this modern view in mind and contrast it with what you will see in ‘olden Singapore’ later.\n\n*Add-on is optional and payable. Payment is to be made during the tour.",
      "image": {
        "url": "https://changiairport.scene7.com/is/image/changiairport/heritage2-chinatownheritagecentre",
        "alt": ""
      },
      "source_component": "cmp-cardlisting--tlslider",
      "slider_index": 1,
      "slide_index": 3
    },
    {
      "index": 4,
      "title": "Singapore River",
      "description": "Known as the lifeline of Singapore, the Singapore River and its quays were where the economy of Singapore began. You will be able to see the former godowns and warehouses along Boat Quay and Clarke Quay as you cross the river.",
      "image": {
        "url": "https://changiairport.scene7.com/is/image/changiairport/SingaporeRiver",
        "alt": "Singapore River"
      },
      "source_component": "cmp-cardlisting--tlslider",
      "slider_index": 1,
      "slide_index": 4
    },
    {
      "index": 5,
      "title": "Kampong Gelam (30-minute stopover)",
      "description": "One of Singapore’s oldest urban quarters. Kampong Gelam is an alluring neighbourhood where age-old traditions meet trendy lifestyles. With a strong Malay-Arab influence, admire the golden dome of the Sultan Mosque set amidst modern art galleries and cafes.",
      "image": {
        "url": "https://changiairport.scene7.com/is/image/changiairport/heritage-tour-image",
        "alt": "Kampong Gelam"
      },
      "source_component": "cmp-cardlisting--tlslider",
      "slider_index": 1,
      "slide_index": 5
    }
