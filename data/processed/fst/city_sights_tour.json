  "itineraries": [
    {
      "index": 1,
      "title": "City Hall",
      "description": "Enter the heart of City Hall, where you will find landmarks like St Andrew’s Cathedral, offering a glimpse of our colonial past. Not far away, the iconic Fullerton Hotel stands as a testament to the city’s history, while modern-day government institutions, like the Parliament house and Supreme Court showcase Singapore’s evolution",
      "image": {
        "url": "https://www.changiairport.com/content/dam/changiairport/sg/airport/evergreen/experience/free-tours/free-singapore-tours/city-sight-tour/citysightstour1-fullertonsingapore.jpg",
        "alt": "City Hall"
      },
      "source_component": "cmp-cardlisting--tlslider",
      "slider_index": 1,
      "slide_index": 1
    },
    {
      "index": 2,
      "title": "Civic District",
      "description": "Witness the growth and progress of Singapore as you contrast old national monuments such as the National Gallery and the Victoria Concert Hall, against modern skyscrapers in the Central Business District. Hear stories of some of Singapore’s most significant moments in history.",
      "image": {
        "url": "https://www.changiairport.com/content/dam/changiairport/sg/airport/evergreen/experience/free-tours/free-singapore-tours/city-sight-tour/citysights2-victoria-concert-hall.jpg",
        "alt": "Tampines Central Park (30-minute stopover)"
      },
      "source_component": "cmp-cardlisting--tlslider",
      "slider_index": 1,
      "slide_index": 2
    },
    {
      "index": 3,
      "title": "Merlion Park (30-minute stopover)",
      "description": "An icon of Singapore, the Merlion was unveiled in 1972 to welcome all visitors to our sunny island. This is a great spot to take photos against the iconic Marina Bay and the city skyline.",
      "image": {
        "url": "https://www.changiairport.com/content/dam/changiairport/sg/airport/evergreen/experience/free-tours/free-singapore-tours/city-sight-tour/citysights3-merlion-park.jpg",
        "alt": "Tampines Central Park (30-minute stopover)"
      },
      "source_component": "cmp-cardlisting--tlslider",
      "slider_index": 1,
      "slide_index": 3
    },
    {
      "index": 4,
      "title": "Gardens by the Bay (30-minute stopover)",
      "description": "Explore the award-winning garden in the heart of the city, featuring more than 500,000 plants across more than 2,200 species. Marvel at the Avatar-like Supertrees that come to life in a display of lights and sounds at night.",
      "image": {
        "url": "https://www.changiairport.com/content/dam/changiairport/sg/airport/evergreen/experience/free-tours/free-singapore-tours/city-sight-tour/citysights4-gbtb-supertree.jpeg",
        "alt": "Tampines Central Park (30-minute stopover)"
      },
      "source_component": "cmp-cardlisting--tlslider",
      "slider_index": 1,
      "slide_index": 4
    },
    {
      "index": 5,
      "title": "Optional add-on: Garden Cruiser Audio Tour*",
      "description": "Enhance your experience at Gardens by the Bay by taking a ride on a special cruiser, with commentary that offers deeper insights into the garden’s horticultural landscape.\n\n*Add-on is optional and comes with an additional cost, at your own expense. Payment will be collected during the tour.",
      "image": {
        "url": "https://www.changiairport.com/content/dam/changiairport/sg/airport/evergreen/experience/free-tours/free-singapore-tours/city-sight-tour/citysightstour5-gbtb-gardencruiser.jpg",
        "alt": "Tampines Central Park (30-minute stopover)"
      },
      "source_component": "cmp-cardlisting--tlslider",
      "slider_index": 1,
      "slide_index": 5
    }
  ],
